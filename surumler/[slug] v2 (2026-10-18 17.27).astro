---
// Mucize sayfası: tek parça akan hikâye (vault: 10-Projeler/Kuran-Mucizeleri/Anlati-Kurali.md).
// Hook (frontmatter) → hikâye (MDX gövdesi: ayet parçası, keşif, alıntı, itirazlar, meydan okuma) → paylaş → kaynaklar.
import { getCollection, render } from 'astro:content';
import Ana from '../../layouts/Ana.astro';
import Kaynakca from '../../components/Kaynakca.astro';
import PaylasKarti from '../../components/PaylasKarti.astro';
import { konular } from '../../taksonomi';

export async function getStaticPaths() {
  const hepsi = await getCollection('mucizeler');
  return hepsi.map((m) => ({ params: { slug: m.id }, props: { m } }));
}
const { m } = Astro.props;
const d = m.data;
const { Content } = await render(m);
const hook = d.hook.trim().split(/\n\s*\n/);
const fark = d.kesif.yil - d.nuzul.yil;
---
<Ana baslik={d.baslik} aciklama={hook[0]}>
  <article class="mucize" data-slug={m.id}>
    <header class="giris">
      <div class="kap okuma-sut ic">
        <p class="ust arayuz">
          <a href="/" class="geri">← Mucizeler</a>
          {d.konu.map((k) => <span class="rozet" style={`--renk:var(--konu-${k})`}>{konular[k as keyof typeof konular].ad}</span>)}
        </p>
        <h1>{d.baslik}</h1>
        {hook.map((p, i) => <p class:list={['hook', { ilk: i === 0 }]}>{p}</p>)}
        <a href="#hikaye" class="asagi arayuz">Okumaya devam <span aria-hidden="true">↓</span></a>
      </div>
    </header>

    <div class="kap okuma-sut hikaye" id="hikaye">
      <Content />
    </div>

    <footer class="kap okuma-sut son">
      <PaylasKarti baslik={d.baslik} soru={d.kart} vurgu={d.vurgu} fark={fark} farkMetni={d.vaat ? 'yıl sonra haber gerçekleşti' : 'yıl sonra insanlık bunu öğrendi'} konu={d.konu[0]} slug={m.id} />
      {d.kaynaklar.length > 0 && (
        <details class="kaynaklar-kat">
          <summary class="arayuz">Kaynaklar ({d.kaynaklar.length})</summary>
          <Kaynakca anahtarlar={d.kaynaklar} baslik={d.baslik} url={Astro.url.href} />
        </details>
      )}
    </footer>
  </article>
</Ana>

<script>
  const slug = document.querySelector<HTMLElement>('.mucize')!.dataset.slug!;
  try {
    const o = new Set(JSON.parse(localStorage.getItem('okunan') ?? '[]'));
    o.add(slug); localStorage.setItem('okunan', JSON.stringify([...o]));
  } catch {}
</script>

<style>
  .mucize { overflow-x: clip; }
  .okuma-sut { max-width: 720px; }

  .ic { padding-block: var(--s7) var(--s4); }
  .ust { display: flex; gap: var(--s2); align-items: center; flex-wrap: wrap; font-size: var(--fs-sm); margin-bottom: var(--s5); }
  .geri { color: var(--soluk); text-decoration: none; margin-right: var(--s2); }
  .giris h1 { margin-bottom: var(--s5); }
  .hook { font-size: clamp(1.2rem, 2.6vw, 1.5rem); line-height: 1.45; margin: 0 0 var(--s3); }
  .hook.ilk { font-size: clamp(1.4rem, 3.4vw, 1.9rem); font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .asagi { display: inline-flex; gap: var(--s2); margin-top: var(--s4); color: var(--soluk); text-decoration: none; font-size: var(--fs-sm); }

  .hikaye { padding-top: var(--s6); font-size: clamp(1.1rem, 2vw, 1.25rem); line-height: 1.8; }
  .hikaye :global(p) { margin: 0 0 var(--s4); }
  .hikaye :global(.genis) { width: 100vw; margin-left: calc(50% - 50vw); }

  .son { padding-bottom: var(--s6); }
  .kaynaklar-kat { margin-top: var(--s6); }
  .kaynaklar-kat summary { cursor: pointer; color: var(--soluk); font-size: var(--fs-sm); }
</style>
