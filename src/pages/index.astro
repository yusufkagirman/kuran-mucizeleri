---
// Ana sayfa: sade mucize listesi. Mucizeler birkaç büyük başlıkta toplanır (taksonomi.ts → grup); arama ve başlığa atlama.
// Eski yıldızlı havuz: surumler/index v1.
import { getCollection } from 'astro:content';
import Ana from '../layouts/Ana.astro';
import { konular, type Konu } from '../taksonomi';

const hepsi = (await getCollection('mucizeler')).sort((a, b) => a.data.baslik.localeCompare(b.data.baslik, 'tr'));
const gruplar = [...new Set(Object.values(konular).map((k) => k.grup))]
  .map((ad) => ({ ad, id: ad.toLocaleLowerCase('tr').replace(/[^a-zçğıöşü]+/g, '-'), uyeler: hepsi.filter((m) => konular[m.data.konu[0] as Konu].grup === ad) }))
  .filter((g) => g.uyeler.length);
---
<Ana baslik="Mucizeler" aciklama="Kur'an'daki mucizeler, sade ve kaynaklı anlatımla.">
  <section class="kap bas">
    <h1>Kur'an mucizeleri</h1>
    <p class="giris soluk">Her biri, konuyu hiç bilmeyen birine anlatır gibi. Ayetiyle, o günün bilgisiyle ve kaynağıyla.</p>
    <input type="search" id="ara" placeholder="Ara: demir, arı, Rum…" aria-label="Mucize ara" />
    <nav class="atla" aria-label="Başlıklar">
      {gruplar.map((g) => <a href={`#${g.id}`}>{g.ad} <span>{g.uyeler.length}</span></a>)}
    </nav>
  </section>

  <section class="kap">
    <a class="sunum" href="/sunum/rum.html">
      <span class="sunum-etiket">Etkileşimli sunum</span>
      <strong>Rumların zaferi, haritada adım adım</strong>
      <span class="soluk">Kaydırdıkça yıllar akar; ayetin verdiği haberin nasıl gerçekleştiğini kendin gör.</span>
      <span class="ok" aria-hidden="true">→</span>
    </a>
  </section>

  {gruplar.map((g) => (
    <section class="kap grup" id={g.id} data-grup>
      <h2>{g.ad}</h2>
      <ul class="liste">
        {g.uyeler.map((m) => (
          <li data-ara={`${m.data.baslik} ${m.data.kart} ${m.data.sureAdi}`.toLocaleLowerCase('tr')}>
            <a class="satir" href={`/mucize/${m.id}`} data-slug={m.id}>
              <strong>{m.data.baslik}</strong>
              <span class="kart-cumle">{m.data.kart}</span>
              <span class="meta">
                <span>{m.data.sureAdi} {m.data.ayetler[0].sure}:{m.data.ayetler[0].ayet}</span>
                <span class="okundu-isaret">Okundu</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="kap bos soluk" id="bos" hidden>Bu aramayla eşleşen mucize yok.</p>
</Ana>

<script>
  let okunan: string[] = [];
  try { okunan = JSON.parse(localStorage.getItem('okunan') ?? '[]'); } catch {}
  document.querySelectorAll<HTMLElement>('.satir').forEach((a) => a.classList.toggle('okundu', okunan.includes(a.dataset.slug!)));

  document.getElementById('ara')!.addEventListener('input', (e) => {
    const s = (e.target as HTMLInputElement).value.trim().toLocaleLowerCase('tr');
    let toplam = 0;
    document.querySelectorAll<HTMLElement>('[data-grup]').forEach((g) => {
      let n = 0;
      g.querySelectorAll<HTMLElement>('[data-ara]').forEach((li) => { const uy = !s || li.dataset.ara!.includes(s); li.hidden = !uy; n += +uy; });
      g.hidden = !n; toplam += n;
    });
    document.getElementById('bos')!.hidden = toplam > 0;
  });
</script>

<style>
  .bas { padding-top: var(--s7); max-width: 1200px; }
  .bas h1 { margin-bottom: var(--s3); }
  .giris { font-size: var(--fs-lg); line-height: 1.5; max-width: 34ch; margin-bottom: var(--s5); }
  input[type='search'] { font: inherit; width: 100%; max-width: 480px; padding: 12px 16px; border-radius: var(--radius); border: 0; box-shadow: var(--golge); background: var(--yuzey); color: var(--murekkep); }
  input[type='search']:focus-visible { outline-offset: 2px; }

  .atla { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s4); }
  .atla a { font-size: var(--fs-sm); color: var(--murekkep); text-decoration: none; padding: 6px 12px; border-radius: var(--radius); background: var(--yuzey-2); transition: background-color var(--t-mikro); }
  .atla a span { color: var(--soluk); margin-left: 2px; }
  .atla a:active { transform: scale(0.97); }

  .sunum { position: relative; display: grid; gap: var(--s1); margin-top: var(--s6); padding: var(--s4) var(--s6) var(--s4) var(--s4); border-radius: var(--radius); background: var(--vurgu-zemin); color: var(--murekkep); text-decoration: none; transition: transform var(--t-mikro) var(--ease-giris); }
  .sunum:active { transform: scale(0.99); }
  .sunum-etiket { font-size: var(--fs-xs); font-weight: 600; color: var(--vurgu-metin); }
  .sunum strong { font-size: var(--fs-lg); letter-spacing: -0.01em; }
  .sunum .ok { position: absolute; right: var(--s4); top: 50%; translate: 0 -50%; font-size: var(--fs-lg); color: var(--vurgu-metin); transition: translate var(--t-bilesen) var(--ease-giris); }

  .grup { scroll-margin-top: 80px; }
  .grup h2 { font-size: var(--fs-lg); margin: var(--s6) 0 var(--s3); }
  .liste { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: var(--s3); }
  .satir { display: grid; gap: var(--s1); height: 100%; padding: var(--s4); border-radius: var(--radius); background: var(--yuzey); box-shadow: var(--golge); color: var(--murekkep); text-decoration: none; transition: transform var(--t-mikro) var(--ease-giris); }
  .satir:active { transform: scale(0.98); }
  .satir strong { font-size: var(--fs-lg); font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .kart-cumle { color: var(--soluk); font-size: var(--fs-sm); line-height: 1.5; }
  .meta { display: flex; justify-content: space-between; gap: var(--s2); margin-top: var(--s2); font-size: var(--fs-xs); color: var(--soluk); align-self: end; }
  .okundu-isaret { display: none; color: var(--vurgu-metin); font-weight: 600; }
  .okundu .okundu-isaret { display: inline; }
  .bos { margin-top: var(--s5); }

  @media (hover: hover) and (pointer: fine) {
    .atla a:hover { background: var(--g4); }
    .satir:hover strong { color: var(--vurgu-metin); }
    .sunum:hover .ok { translate: 4px -50%; }
  }
</style>
