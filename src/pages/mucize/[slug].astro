---
// Mucize sunumu: Rum sunumunun (public/sunum/rum.html) dili, metin MDX'ten.
// Tam ekran giriş → <Hikaye> (yıl paneli + kayan adım kartları) → akla gelen sorular → son söz → paylaş + kaynaklar.
// Rum'un kendi haritalı sunumu var: /mucize/rum → /sunum/rum.html (astro.config.mjs).
import { getCollection, render } from 'astro:content';
import Ana from '../../layouts/Ana.astro';
import Kaynakca from '../../components/Kaynakca.astro';
import PaylasKarti from '../../components/PaylasKarti.astro';
import { konular } from '../../taksonomi';

export async function getStaticPaths() {
  const hepsi = await getCollection('mucizeler');
  return hepsi.filter((m) => m.id !== 'rum').map((m) => ({ params: { slug: m.id }, props: { m } }));
}
const { m } = Astro.props;
const d = m.data;
const { Content } = await render(m);
const hook = d.hook.trim().split(/\n\s*\n/);
const fark = d.kesif.yil - d.nuzul.yil;
const a = d.ayetler[0];
---
<Ana baslik={d.baslik} aciklama={hook[0]}>
  <article class="mucize" data-slug={m.id}>
    <header class="giris">
      {d.vurgu && <div class="fon arapca" aria-hidden="true">{d.vurgu}</div>}
      <div class="giris-ic">
        <p class="ust-yazi">
          {d.sureAdi} suresi · {a.sure}:{a.ayet}
          {d.konu.map((k) => <span class="rozet" style={`--renk:var(--konu-${k})`}>{konular[k as keyof typeof konular].ad}</span>)}
        </p>
        <h1>{d.baslik}</h1>
        {hook.map((p, i) => <p class:list={['hook', { soluk: i > 0 }]}>{p}</p>)}
        <div class="asagi">Kaydırın</div>
      </div>
    </header>

    <div class="icerik">
      <Content />
    </div>

    <footer class="son">
      <PaylasKarti baslik={d.baslik} soru={d.kart} vurgu={d.vurgu} fark={fark} farkMetni={d.vaat ? 'yıl sonra haber gerçekleşti' : 'yıl sonra insanlık bunu öğrendi'} konu={d.konu[0]} slug={m.id} />
      {d.kaynaklar.length > 0 && (
        <details class="kaynaklar-kat">
          <summary class="arayuz">Kaynaklar ({d.kaynaklar.length})</summary>
          <Kaynakca anahtarlar={d.kaynaklar} baslik={d.baslik} url={Astro.url.href} />
        </details>
      )}
      <a href="/" class="geri">← Tüm mucizeler</a>
    </footer>
  </article>
</Ana>

<script>
  const slug = document.querySelector<HTMLElement>('.mucize')!.dataset.slug!;
  try {
    const o = new Set(JSON.parse(localStorage.getItem('okunan') ?? '[]'));
    o.add(slug); localStorage.setItem('okunan', JSON.stringify([...o]));
  } catch {}
</script>

<style>
  .mucize { overflow-x: clip; }

  /* Giriş: rum.html ile aynı tam ekran, ortalı kapak */
  .giris { position: relative; min-height: calc(100svh - 64px); display: grid; place-items: center; text-align: center; padding: var(--s7) var(--s3); overflow: hidden; }
  .fon { position: absolute; inset: 0; display: grid; place-items: center; padding: 0 var(--s3); pointer-events: none; font-size: clamp(4rem, 16vw, 12rem); line-height: 1.3; color: var(--murekkep); opacity: 0.05; }
  .giris-ic { position: relative; max-width: 760px; }
  .ust-yazi { display: flex; justify-content: center; align-items: center; gap: var(--s2); flex-wrap: wrap; margin: 0; font-size: var(--fs-md); font-weight: 500; color: var(--soluk); }
  .ust-yazi .rozet { margin-left: var(--s1); }
  .giris h1 { font-size: clamp(2.75rem, 8vw, 5rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.02; margin: 0.25em 0 0.35em; }
  .hook { max-width: 38ch; margin: 0 auto 1em; font-size: clamp(1.05rem, 2.6vw, 1.25rem); }
  .hook.soluk { font-size: var(--fs-md); }
  .asagi { margin-top: var(--s5); font-size: var(--fs-xs); font-weight: 500; color: var(--soluk); display: inline-flex; flex-direction: column; align-items: center; gap: var(--s2); }
  .asagi::after { content: ''; width: 1px; height: 40px; background: var(--soluk); transform-origin: top; animation: in 2.2s ease-in-out infinite; }
  @keyframes in { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .asagi::after { animation: none; } }

  /* Hikâyeden sonrası tek okuma sütunu */
  .icerik { font-size: var(--fs-md); line-height: 1.65; }
  .icerik > :global(:not(.hikaye)) { width: min(720px, 100% - 32px); margin-inline: auto; }
  .icerik > :global(p) { margin-top: var(--s8); margin-bottom: var(--s3); font: 700 clamp(1.75rem, 4.5vw, 2.4rem)/1.15 var(--font-baslik); letter-spacing: -0.025em; text-wrap: balance; }

  .son { width: min(720px, 100% - 32px); margin: 0 auto; padding-bottom: var(--s6); }
  .kaynaklar-kat { margin-top: var(--s6); }
  .kaynaklar-kat summary { cursor: pointer; color: var(--soluk); font-size: var(--fs-sm); }
  .geri { display: inline-block; margin-top: var(--s5); color: var(--soluk); text-decoration: none; font-size: var(--fs-sm); }
</style>
