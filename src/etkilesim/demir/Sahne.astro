---
// Demir mucizesi, "Keşif" bölümü: kaydırmaya bağlı sinematik canvas sahnesi.
// Yıldız → katmanlar → demir çekirdek → çöküş → süpernova → toz bulutu → Dünya'nın demir çekirdeği.
const altyazilar = [
  'Her yıldız hidrojen yakar.',
  'Büyük yıldızların içi katman katman ağır elementlere dönüşür.',
  'Demir, yıldızın son durağıdır.',
  'Çekirdek çöker.',
  'Süpernova: demir uzaya saçılır.',
  'Bu toz yeni dünyaların hammaddesi olur.',
  "Dünya'nın demiri gökten gelmiştir.",
];
---
<section class="demir-sahne" aria-label="Demirin yıldızlardan Dünya'ya yolculuğu">
  <div class="sahne">
    <canvas
      role="img"
      aria-label="Animasyon: bir yıldız hidrojen yakar, içi katman katman ağır elementlere dönüşür, demir çekirdek çöker, süpernova demiri uzaya saçar, bu toz bir gezegen oluşturur ve Dünya'nın demir çekirdeği görünür."
    ></canvas>
    <p class="altyazi" aria-live="polite" data-altyazilar={JSON.stringify(altyazilar)}>{altyazilar[0]}</p>
    <ol class="ilerleme" aria-hidden="true">
      {altyazilar.map(() => <li><span></span></li>)}
    </ol>
  </div>
</section>

<script>
  type RGB = [number, number, number];
  const clamp = (x: number, a = 0, b = 1) => (x < a ? a : x > b ? b : x);
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const ease = (x: number) => x * x * (3 - 2 * x);
  const easeOut = (x: number) => 1 - (1 - x) ** 3;
  const easeIn = (x: number) => x * x * x;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const mix = (a: RGB, b: RGB, t: number): RGB => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
  const rgba = (c: RGB, a: number) => `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${clamp(a)})`;
  const TAU = Math.PI * 2;

  // Sahne sınırları (ilerleme 0→1); altyazı ve ilerleme çubuğu da bunu kullanır.
  const ESIK = [0, 0.125, 0.3, 0.42, 0.5, 0.68, 0.845, 1];

  // Renk çözümleyici: CSS token'ı ne biçimde gelirse gelsin canvas'a normalleştirir.
  const prob = document.createElement('canvas').getContext('2d')!;
  function rgb(s: string): RGB {
    prob.fillStyle = '#000';
    prob.fillStyle = s.trim() || '#000';
    const v = String(prob.fillStyle);
    if (v[0] === '#') return [parseInt(v.slice(1, 3), 16), parseInt(v.slice(3, 5), 16), parseInt(v.slice(5, 7), 16)];
    const m = v.match(/[\d.]+/g) || ['0', '0', '0'];
    return [+m[0], +m[1], +m[2]];
  }

  function kur(sec: HTMLElement) {
    const canvas = sec.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const altyazi = sec.querySelector<HTMLElement>('.altyazi')!;
    const metinler: string[] = JSON.parse(altyazi.dataset.altyazilar || '[]');
    const dolgular = [...sec.querySelectorAll<HTMLElement>('.ilerleme span')];
    const rm = matchMedia('(prefers-reduced-motion: reduce)');

    // --- Renkler ---
    let C: Record<string, RGB> = {};
    let koyu = true;
    let fontArayuz = 'sans-serif';
    let sprite: HTMLCanvasElement;
    function renkleriOku() {
      const cs = getComputedStyle(document.documentElement);
      const t = (n: string) => rgb(cs.getPropertyValue(n));
      C = {
        zemin: t('--zemin'), murekkep: t('--murekkep'), soluk: t('--soluk'),
        vurgu: t('--vurgu'), vurgu2: t('--vurgu-2'), gok: t('--konu-gokyuzu'), yer: t('--konu-yeryuzu'),
      };
      const z = C.zemin;
      koyu = 0.2126 * z[0] + 0.7152 * z[1] + 0.0722 * z[2] < 128;
      C.sicak = koyu ? [255, 244, 218] : [255, 251, 240];
      // akkor demir: gecede beyaza, parşömende kehribara çalar (beyaz parşömende kaybolur)
      C.kor = koyu ? mix(C.vurgu, C.sicak, 0.55) : mix(C.vurgu, [236, 156, 64], 0.6);
      C.ates = koyu ? mix(C.vurgu, [238, 92, 44], 0.65) : mix(C.vurgu, [200, 50, 30], 0.3); // kızaran demir
      fontArayuz = cs.getPropertyValue('--font-arayuz').trim() || 'sans-serif';
      // Parçacık parıltısı tek sefer ön-çizilir, her karede drawImage ile basılır.
      sprite = document.createElement('canvas');
      sprite.width = sprite.height = 64;
      const s = sprite.getContext('2d')!;
      const g = s.createRadialGradient(32, 32, 0, 32, 32, 32);
      g.addColorStop(0, rgba(koyu ? C.sicak : C.kor, 1));
      g.addColorStop(0.18, rgba(C.kor, koyu ? 0.95 : 1));
      g.addColorStop(0.45, rgba(C.vurgu, koyu ? 0.35 : 0.45));
      g.addColorStop(1, rgba(C.vurgu, 0));
      s.fillStyle = g;
      s.fillRect(0, 0, 64, 64);
      kirli = true;
    }

    // --- Ön-hesaplanmış diziler ---
    const N = matchMedia('(max-width: 760px)').matches ? 300 : 700;
    const pAci = new Float32Array(N), pHiz = new Float32Array(N), pBoy = new Float32Array(N);
    const pDisk = new Float32Array(N), pTeta = new Float32Array(N), pIsi = new Float32Array(N);
    for (let i = 0; i < N; i++) {
      pAci[i] = Math.random() * TAU;
      pHiz[i] = 0.35 + Math.random() ** 0.6 * 0.65;
      pBoy[i] = 0.6 + Math.random() ** 3 * 1.8;
      pDisk[i] = 0.12 + Math.sqrt(Math.random()) * 0.88;
      pTeta[i] = Math.random() * TAU;
      pIsi[i] = Math.random();
    }
    const YN = 220;
    const yX = new Float32Array(YN), yY = new Float32Array(YN), yB = new Float32Array(YN), yF = new Float32Array(YN);
    for (let i = 0; i < YN; i++) {
      yX[i] = Math.random(); yY[i] = Math.random();
      yB[i] = Math.random() ** 4 * 1.6 + 0.4; yF[i] = Math.random() * TAU;
    }
    // Yıldız katmanları: dıştan içe. Renk soğuktan (gökyüzü) sıcağa (vurgu) akar.
    const KATMAN = [
      { ad: 'H', r: 0.96, renk: () => C.gok },
      { ad: 'He', r: 0.8, renk: () => mix(C.gok, C.vurgu2, 0.6) },
      { ad: 'C', r: 0.65, renk: () => C.vurgu2 },
      { ad: 'O', r: 0.5, renk: () => C.yer },
      { ad: 'Si', r: 0.36, renk: () => mix(C.yer, C.vurgu, 0.55) },
    ];
    const FE_R = 0.22;
    // Dünya kıtaları (birim daire koordinatı, yalnız sol yarıda görünür)
    // Her kıta, gelişigüzel kümelenmiş dairelerden oluşan düzensiz bir leke: [x, y, r]
    const KITA: number[][] = [];
    for (const [kx, ky, yay, n] of [[-0.55, -0.4, 0.2, 9], [-0.32, 0.12, 0.22, 11], [-0.72, 0.35, 0.1, 5], [-0.15, -0.72, 0.12, 5], [-0.4, 0.68, 0.1, 5]]) {
      for (let j = 0; j < n; j++) {
        const a = Math.random() * TAU, d = Math.random() * yay;
        KITA.push([kx + Math.cos(a) * d, ky + Math.sin(a) * d * 1.3, 0.04 + Math.random() * yay * 0.45]);
      }
    }

    // --- Boyut ---
    let W = 0, H = 0, dpr = 1, cx = 0, cy = 0, R = 0, maxD = 0;
    function boyutla() {
      sec.style.setProperty('--sayfa-gen', document.documentElement.clientWidth + 'px');
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      cx = W / 2; cy = H * 0.42;
      R = Math.min(W * 0.36, H * 0.21);
      maxD = Math.hypot(W, H) * 0.55;
      kirli = true;
    }

    function parilti(x: number, y: number, r: number, c: RGB, a: number) {
      if (a <= 0.003 || r <= 0) return;
      const g = ctx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, rgba(c, a));
      g.addColorStop(0.35, rgba(c, a * 0.45));
      g.addColorStop(1, rgba(c, 0));
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(x, y, r, 0, TAU); ctx.fill();
    }
    function etiket(s: string, x: number, y: number, boy: number, c: RGB, a: number) {
      if (a <= 0.01) return;
      ctx.font = `600 ${boy}px ${fontArayuz}`;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillStyle = rgba(c, a);
      ctx.fillText(s, x, y);
    }
    const ekle = () => (ctx.globalCompositeOperation = koyu ? 'lighter' : 'source-over');
    const normal = () => (ctx.globalCompositeOperation = 'source-over');

    // Parçacık konumu: ilerleme ve disk dönüşünün saf fonksiyonu (iz için geçmiş tutulmaz).
    const out = [0, 0];
    function ppos(i: number, p: number, don: number) {
      const k5 = seg(p, 0.495, 0.72);
      const d = easeOut(k5) * pHiz[i] * maxD;
      const kivrim = k5 * 0.35 * (pIsi[i] - 0.5);
      let x = cx + Math.cos(pAci[i] + kivrim) * d;
      let y = cy + Math.sin(pAci[i] + kivrim) * d;
      const k6 = ease(seg(p, 0.66, 0.84));
      if (k6 > 0) {
        const rr = pDisk[i] * R * 1.9;
        const a = pTeta[i] + (k6 * 2.4 + don) / Math.sqrt(pDisk[i] + 0.15);
        x += (cx + Math.cos(a) * rr - x) * k6;
        y += (cy + Math.sin(a) * rr * 0.34 - y) * k6;
      }
      const k7 = easeIn(seg(p, 0.84, 0.93));
      if (k7 > 0) { x += (cx - x) * k7; y += (cy - y) * k7; }
      out[0] = x; out[1] = y;
    }

    function ciz(p: number, t: number) {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      normal();
      ctx.globalAlpha = 1;
      ctx.fillStyle = rgba(C.zemin, 1);
      ctx.fillRect(0, 0, W, H);

      // Arka plan: gece göğünde yıldızlar, parşömende mürekkep zerreleri
      for (let i = 0; i < YN; i++) {
        const a = koyu ? 0.25 + 0.35 * (0.5 + 0.5 * Math.sin(t * (0.6 + yB[i]) + yF[i])) : 0.1 + 0.06 * yB[i];
        ctx.fillStyle = rgba(koyu ? C.murekkep : C.soluk, a * (koyu ? 0.75 : 1));
        const s = yB[i] * (koyu ? 1 : 0.8);
        ctx.fillRect(yX[i] * W, yY[i] * H, s, s);
      }
      // Patlamadan sonra gök hafifçe tozla dolar
      const toz = seg(p, 0.52, 0.72) * (1 - seg(p, 0.86, 0.96));
      if (toz > 0) {
        ekle();
        parilti(cx - W * 0.18, cy + H * 0.05, maxD * 0.7, C.vurgu2, 0.07 * toz);
        parilti(cx + W * 0.2, cy - H * 0.1, maxD * 0.6, C.gok, 0.06 * toz);
        normal();
      }

      const nefes = Math.sin(t * 1.5) * 0.018 + Math.sin(t * 0.7) * 0.008;
      const parla = 0.55 + 0.45 * ease(seg(p, 0, 0.1));
      const kesit = ease(seg(p, 0.11, 0.2));
      const feB = ease(seg(p, 0.3, 0.42));
      const cok = seg(p, 0.42, 0.5) ** 2;
      const yildizA = 1 - seg(p, 0.495, 0.505);
      const Rs = R * (1 + nefes * (1 - cok)) * (1 - 0.9 * cok);

      // --- 1–4: Yıldız ---
      if (yildizA > 0) {
        ctx.globalAlpha = yildizA;
        ekle();
        // dış hale ve ışınlar
        parilti(cx, cy, R * (2.7 + 0.15 * nefes * 10) * (1 - 0.5 * cok), C.vurgu, (koyu ? 0.34 : 0.2) * parla * (1 + cok));
        parilti(cx, cy, R * 1.55 * (1 - 0.6 * cok), C.sicak, (koyu ? 0.28 : 0.18) * parla);
        ctx.lineCap = 'round';
        for (let i = 0; i < 18; i++) {
          const a = (i / 18) * TAU + t * 0.03;
          const uz = Rs * (1.18 + 0.22 * (0.5 + 0.5 * Math.sin(t * 0.9 + i * 1.7)));
          ctx.strokeStyle = rgba(C.kor, (koyu ? 0.16 : 0.12) * parla * (1 - kesit * 0.6));
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.moveTo(cx + Math.cos(a) * Rs * 1.03, cy + Math.sin(a) * Rs * 1.03);
          ctx.lineTo(cx + Math.cos(a) * uz, cy + Math.sin(a) * uz);
          ctx.stroke();
        }
        normal();
        // gövde: akkor merkez, kenar kararması
        const g = ctx.createRadialGradient(cx - Rs * 0.15, cy - Rs * 0.15, 0, cx, cy, Rs);
        g.addColorStop(0, rgba(C.sicak, 1));
        g.addColorStop(0.45, rgba(mix(C.sicak, C.vurgu, 0.45), 1));
        g.addColorStop(0.85, rgba(C.vurgu, 1));
        g.addColorStop(1, rgba(mix(C.vurgu, C.zemin, koyu ? 0.35 : 0.15), 1));
        ctx.globalAlpha = yildizA * (1 - 0.78 * kesit);
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(cx, cy, Rs, 0, TAU); ctx.fill();
        ctx.globalAlpha = yildizA;

        // --- 2: Katmanlar (dıştan içe sırayla) ---
        const feR = Rs * (FE_R + 0.11 * feB);
        const yaziBoy = Math.max(11, R * 0.085);
        for (let i = 0; i < KATMAN.length; i++) {
          const k = KATMAN[i];
          const g0 = 0.13 + i * 0.027;
          const li = ease(seg(p, g0, g0 + 0.045));
          if (li <= 0) continue;
          const dis = Rs * k.r * (0.9 + 0.1 * li);
          const ic = i + 1 < KATMAN.length ? Rs * KATMAN[i + 1].r : feR;
          const c = k.renk();
          ctx.beginPath();
          ctx.arc(cx, cy, dis, 0, TAU);
          ctx.arc(cx, cy, Math.min(ic, dis - 1), 0, TAU, true);
          ctx.fillStyle = rgba(mix(c, C.zemin, koyu ? 0.35 : 0.25), (koyu ? 0.72 : 0.62) * li);
          ctx.fill();
          ctx.strokeStyle = rgba(mix(c, C.sicak, koyu ? 0.35 : 0), 0.95 * li);
          ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.arc(cx, cy, dis, 0, TAU); ctx.stroke();
          const ey = cy - (dis + Math.min(ic, dis)) / 2;
          etiket(k.ad, cx, ey, yaziBoy * (1 - 0.6 * cok), koyu ? C.murekkep : C.zemin, li * (1 - seg(p, 0.42, 0.47)));
        }
        // Fe çekirdek
        const fi = ease(seg(p, 0.13 + 5 * 0.027, 0.13 + 5 * 0.027 + 0.045));
        if (fi > 0) {
          const nabiz = 0.5 + 0.5 * Math.sin(t * (2 + 6 * feB));
          ekle();
          parilti(cx, cy, feR * (1.6 + 1.6 * feB + 0.25 * nabiz * feB), C.ates, (0.25 + 0.55 * feB) * fi);
          normal();
          const fg = ctx.createRadialGradient(cx, cy, 0, cx, cy, feR);
          const ic = mix(mix(C.vurgu, C.ates, feB), C.sicak, 0.15 + 0.25 * feB * nabiz);
          fg.addColorStop(0, rgba(ic, fi));
          fg.addColorStop(1, rgba(mix(mix(C.vurgu, C.ates, feB), C.murekkep, koyu ? 0 : 0.2), fi));
          ctx.fillStyle = fg;
          ctx.beginPath(); ctx.arc(cx, cy, feR, 0, TAU); ctx.fill();
          etiket('Fe', cx, cy, Math.max(13, R * 0.12) * (1 + 0.25 * feB) * (1 - 0.7 * cok), koyu ? C.zemin : C.zemin, fi * (1 - seg(p, 0.44, 0.48)));
        }
        ctx.globalAlpha = 1;
      }

      // --- 5: Şok dalgası ---
      const k5 = seg(p, 0.495, 0.7);
      if (k5 > 0 && k5 < 1) {
        const r = easeOut(k5) * maxD * 1.15;
        const a = (1 - k5) ** 1.3;
        ekle();
        ctx.strokeStyle = rgba(C.vurgu, 0.25 * a);
        ctx.lineWidth = lerp(46, 4, k5);
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, TAU); ctx.stroke();
        ctx.strokeStyle = rgba(C.kor, 0.9 * a);
        ctx.lineWidth = lerp(14, 0.6, k5);
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, TAU); ctx.stroke();
        ctx.strokeStyle = rgba(C.vurgu2, 0.5 * a);
        ctx.lineWidth = lerp(5, 0.4, k5);
        ctx.beginPath(); ctx.arc(cx, cy, r * 0.82, 0, TAU); ctx.stroke();
        // kalıntı bulutsu
        parilti(cx, cy, r * 0.75, C.vurgu, 0.22 * a);
        normal();
      }

      // --- 5–7: Demir parçacıkları ---
      const pA = seg(p, 0.495, 0.515) * (1 - seg(p, 0.89, 0.95));
      if (pA > 0) {
        const don = t * 0.06;
        const iz = lerp(0.014, 0.005, seg(p, 0.6, 0.7));
        const izMax = R * lerp(1.2, 0.35, seg(p, 0.6, 0.72)); // toplanırken izler kısalır
        ctx.globalAlpha = pA;
        ekle();
        ctx.strokeStyle = rgba(C.vurgu, koyu ? 0.35 : 0.45);
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let i = 0; i < N; i++) {
          ppos(i, Math.max(0.495, p - iz), don - 0.04);
          const x0 = out[0], y0 = out[1];
          ppos(i, p, don);
          const dx = x0 - out[0], dy = y0 - out[1], d = Math.hypot(dx, dy);
          const k = d > izMax ? izMax / d : 1;
          ctx.moveTo(out[0] + dx * k, out[1] + dy * k);
          ctx.lineTo(out[0], out[1]);
        }
        ctx.stroke();
        for (let i = 0; i < N; i++) {
          ppos(i, p, don);
          const s = pBoy[i] * (5 + 5 * pIsi[i]) * (1 + 0.6 * (1 - seg(p, 0.5, 0.62)));
          ctx.drawImage(sprite, out[0] - s / 2, out[1] - s / 2, s, s);
        }
        normal();
        ctx.globalAlpha = 1;
      }

      // --- 6: Dönen bulut ve doğan gezegen ---
      const k6 = ease(seg(p, 0.66, 0.82)) * (1 - ease(seg(p, 0.86, 0.95)));
      if (k6 > 0) {
        ctx.save();
        ctx.translate(cx, cy);
        ctx.scale(1, 0.34);
        ekle();
        parilti(0, 0, R * 2.1, C.vurgu, (koyu ? 0.22 : 0.16) * k6);
        parilti(0, 0, R * 1.2, C.kor, (koyu ? 0.18 : 0.1) * k6);
        normal();
        ctx.restore();
      }
      const gz = ease(seg(p, 0.72, 0.86));
      const e7 = ease(seg(p, 0.84, 0.95));
      const pr = R * 0.16 * gz;
      if (gz > 0 && e7 < 1) {
        ctx.globalAlpha = 1 - e7;
        ekle();
        parilti(cx, cy, pr * 3, C.kor, 0.45 * gz);
        normal();
        const g = ctx.createRadialGradient(cx - pr * 0.35, cy - pr * 0.35, 0, cx, cy, pr);
        g.addColorStop(0, rgba(mix(C.kor, C.sicak, 0.3), 1));
        g.addColorStop(0.6, rgba(mix(C.yer, C.vurgu, 0.5), 1));
        g.addColorStop(1, rgba(mix(C.yer, C.zemin, 0.3), 1));
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(cx, cy, Math.max(pr, 0.1), 0, TAU); ctx.fill();
        ctx.globalAlpha = 1;
      }

      // --- 7: Dünya, yarım kesit ---
      if (e7 > 0) {
        const er = lerp(R * 0.16, R * 0.98, e7);
        const ac = ease(seg(p, 0.9, 0.975));
        const nabiz = 0.5 + 0.5 * Math.sin(t * 2.2);
        ctx.globalAlpha = e7;
        ekle();
        parilti(cx, cy, er * 1.35, C.gok, koyu ? 0.3 : 0.18);
        normal();
        // yerküre yüzeyi
        ctx.save();
        ctx.beginPath(); ctx.arc(cx, cy, er, 0, TAU); ctx.clip();
        const okyanus = ctx.createRadialGradient(cx - er * 0.4, cy - er * 0.4, 0, cx, cy, er);
        okyanus.addColorStop(0, rgba(mix(C.gok, C.sicak, 0.35), 1));
        okyanus.addColorStop(1, rgba(mix(C.gok, C.zemin, koyu ? 0.45 : 0.15), 1));
        ctx.fillStyle = okyanus;
        ctx.fillRect(cx - er, cy - er, er * 2, er * 2);
        ctx.fillStyle = rgba(mix(C.yer, C.vurgu2, 0.25), 0.9);
        ctx.beginPath();
        for (const [x, y, r] of KITA) {
          ctx.moveTo(cx + (x + r) * er, cy + y * er);
          ctx.arc(cx + x * er, cy + y * er, r * er, 0, TAU);
        }
        ctx.fill();
        const golge = ctx.createRadialGradient(cx - er * 0.5, cy - er * 0.5, er * 0.2, cx, cy, er * 1.05);
        golge.addColorStop(0, 'rgba(0,0,0,0)');
        golge.addColorStop(1, rgba(koyu ? [0, 0, 0] : C.murekkep, 0.45));
        ctx.fillStyle = golge;
        ctx.fillRect(cx - er, cy - er, er * 2, er * 2);

        // sağ yarı: kesit (kabuk → manto → dış çekirdek → iç çekirdek)
        if (ac > 0) {
          ctx.beginPath(); ctx.rect(cx, cy - er, er, er * 2); ctx.clip();
          ctx.globalAlpha = e7 * ac;
          const kat: [number, RGB][] = [
            [1, mix(C.yer, C.zemin, koyu ? 0.2 : 0)],
            [0.9, mix(C.yer, C.vurgu, 0.5)],
            [0.55, C.vurgu],
            [0.22, mix(C.kor, C.sicak, koyu ? 0.2 + 0.3 * nabiz : 0.1 * nabiz)],
          ];
          for (const [f, c] of kat) {
            const rr = er * f * lerp(0.6, 1, ac);
            ctx.fillStyle = rgba(c, 1);
            ctx.beginPath(); ctx.arc(cx, cy, Math.min(rr, er), 0, TAU); ctx.fill();
          }
          ekle();
          parilti(cx, cy, er * (0.75 + 0.08 * nabiz), C.kor, (koyu ? 0.55 : 0.4) * ac);
          normal();
          etiket('Fe', cx + er * 0.37, cy, Math.max(13, R * 0.13), C.zemin, ac);
        }
        ctx.restore();
        // kesim çizgisi ve kenar
        ctx.globalAlpha = e7;
        ctx.strokeStyle = rgba(koyu ? C.sicak : C.murekkep, 0.55 * ac);
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(cx, cy - er); ctx.lineTo(cx, cy + er); ctx.stroke();
        ctx.strokeStyle = rgba(koyu ? C.gok : C.murekkep, koyu ? 0.6 : 0.4);
        ctx.beginPath(); ctx.arc(cx, cy, er, 0, TAU); ctx.stroke();
        ctx.globalAlpha = 1;
      }

      // --- 4→5: beyaz parlama ---
      const fl = p < 0.5 ? ease(seg(p, 0.475, 0.5)) : 1 - ease(seg(p, 0.5, 0.57));
      if (fl > 0) {
        ekle();
        parilti(cx, cy, maxD * (0.4 + fl), C.sicak, 0.9 * fl);
        normal();
        ctx.fillStyle = rgba(C.sicak, 0.85 * fl * fl);
        ctx.fillRect(0, 0, W, H);
      }
    }

    // --- Altyazı ve ilerleme ---
    let aktif = 0;
    let gecis = 0;
    function arayuz(p: number) {
      let idx = 0;
      for (let i = 0; i < 7; i++) if (p >= ESIK[i]) idx = i;
      for (let i = 0; i < 7; i++) dolgular[i].style.transform = `scaleX(${seg(p, ESIK[i], ESIK[i + 1])})`;
      if (idx === aktif) return;
      aktif = idx;
      clearTimeout(gecis);
      if (rm.matches) { altyazi.textContent = metinler[idx]; return; }
      altyazi.classList.add('gizli');
      gecis = window.setTimeout(() => {
        altyazi.textContent = metinler[aktif];
        altyazi.classList.remove('gizli');
      }, 220);
    }

    // --- Döngü ---
    let kirli = true;
    let p = 0, t = 0, son = 0, raf = 0, gorunur = false;
    function hedef() {
      const r = sec.getBoundingClientRect();
      const toplam = r.height - innerHeight;
      return toplam > 0 ? clamp(-r.top / toplam) : 0;
    }
    function kare(ms: number) {
      raf = 0;
      if (!gorunur) return;
      const dt = Math.min((ms - (son || ms)) / 1000, 0.1);
      son = ms;
      const h = hedef();
      const onceki = p;
      p += (h - p) * (1 - Math.pow(0.0015, dt)); // kaydırma yumuşatma
      if (Math.abs(h - p) < 0.0002) p = h;
      if (!rm.matches) t += dt;
      // Hareket azaltıldıysa yalnız ilerleme değişince çiz.
      if (!rm.matches || p !== onceki || kirli) { ciz(p, t); arayuz(p); kirli = false; }
      raf = requestAnimationFrame(kare);
    }
    function baslat() { if (!raf && gorunur) { son = 0; raf = requestAnimationFrame(kare); } }

    renkleriOku();
    boyutla();
    p = hedef();
    ciz(p, 0);
    arayuz(p);

    new IntersectionObserver(([e]) => { gorunur = e.isIntersecting; baslat(); }).observe(sec);
    new ResizeObserver(() => { boyutla(); ciz(p, t); }).observe(canvas);
    window.addEventListener('resize', boyutla);
    const yenile = () => { renkleriOku(); ciz(p, t); };
    document.addEventListener('palet', yenile);
    new MutationObserver(yenile).observe(document.documentElement, { attributes: true, attributeFilter: ['data-palet'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', yenile);
    rm.addEventListener('change', () => (kirli = true));
  }

  document.querySelectorAll<HTMLElement>('.demir-sahne').forEach(kur);
</script>

