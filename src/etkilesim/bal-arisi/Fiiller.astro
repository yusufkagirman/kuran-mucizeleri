---
// Dişi bal arısı: ayetteki üç emir fiili yan yana, çiçekteki işçi arı fotoğrafıyla. Anlamlar sayfadaki Diyanet mealinden.
const taban = import.meta.env.BASE_URL.replace(/\/$/, '');
const fiiller = [
  { ar: 'ٱتَّخِذِى', ok: 'ittehızî', tr: 'yuva edin' },
  { ar: 'كُلِى', ok: 'kulî', tr: 'ye' },
  { ar: 'فَٱسْلُكِى', ok: 'fesülükî', tr: 'yürü' },
];
---
<figure class="fiiller">
  <div class="foto">
    <img src={`${taban}/img/bal-arisi/isci-cicekte.jpg`} alt="Pembe beyaz çiçeklerin arasında, hortumunu çiçeğe uzatmış bir bal arısı." loading="lazy" decoding="async" />
    <small class="kunye arayuz"><a href="https://commons.wikimedia.org/wiki/File:Worker_bee_on_flower_-_Drahel%C4%8Dice_(53549159528).jpg" rel="noopener">Ted Moravec, CC0</a></small>
  </div>
  <ol class="liste" aria-label="Ayetteki üç emir">
    {fiiller.map((f) => (
      <li>
        <span class="ar arapca" lang="ar">{f.ar}</span>
        <span class="ok arayuz"><i>{f.ok}</i> · {f.tr}</span>
        <span class="kip arayuz">dişil kip</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .fiiller { margin: var(--s6) 0; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--s4); align-items: center; }
  @media (max-width: 640px) { .fiiller { grid-template-columns: 1fr; } }
  .foto img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--cizgi-renk); }
  .kunye { display: block; margin-top: 4px; font-size: 0.7rem; color: var(--soluk); }
  .kunye a { color: inherit; text-decoration: underline dotted; }
  .liste { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); }
  li { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'ar ok' 'ar kip'; column-gap: var(--s4); align-items: center; padding: var(--s3) var(--s4); background: var(--yuzey); border: 1px solid var(--cizgi-renk); border-left: 3px solid var(--konu-canlilar); border-radius: var(--radius); }
  .ar { grid-area: ar; font-size: clamp(2rem, 6vw, 2.8rem); line-height: 1.3; color: var(--murekkep); min-width: 3.5em; text-align: center; }
  .ok { grid-area: ok; font-size: var(--fs-md); }
  .kip { grid-area: kip; justify-self: start; font-size: var(--fs-xs); font-weight: 600; color: var(--konu-canlilar); }
  @media (max-width: 640px) { .foto img { aspect-ratio: 4 / 3; } }
</style>
