---
// Mucize sunumu: Rum sunumunun dili (public/sunum/rum.html). Yapışkan sahne (soluk ayet + yıl paneli), üstünden kayan adım kartları.
// Yıl paneli: aktif adımın yılı, ayetle arası ve ayet → keşif çizgisindeki yeri. Kullanım (MDX): <Hikaye veri={frontmatter}> <Adim …> … </Hikaye>
interface Props { veri: { nuzul: { yil: number }; kesif: { yil: number }; vaat?: unknown; vurgu?: string } }
const { nuzul, kesif, vaat, vurgu } = Astro.props.veri;
---
<div class="hikaye" data-nuzul={nuzul.yil} data-kesif={kesif.yil}>
  <div class="sahne" aria-hidden="true">
    {vurgu && <p class="fon arapca">{vurgu}</p>}
    <div class="hud">
      <p class="hud-yil"><span data-yil>{nuzul.yil}</span><small data-not>ayetin indiği yıllar</small></p>
      <div class="hud-cizgi">
        <div class="ray"><i class="dolu"></i><span class="isaret-kap"><i class="isaret"></i></span></div>
        <div class="uclar"><span>Ayet ~{nuzul.yil}</span><span>{kesif.yil} · {vaat ? 'gerçekleşme' : 'keşif'}</span></div>
      </div>
    </div>
  </div>
  <div class="adimlar"><slot /></div>
</div>

<script>
  const yilYaz = (y: number) => (y < 0 ? `MÖ ${-y}` : String(y));
  document.querySelectorAll<HTMLElement>('.hikaye').forEach((h) => {
    const n = +h.dataset.nuzul!, k = +h.dataset.kesif!;
    const yilEl = h.querySelector<HTMLElement>('[data-yil]')!, notEl = h.querySelector<HTMLElement>('[data-not]')!;
    const adimlar = [...h.querySelectorAll<HTMLElement>('.adim')];
    // Yılı olmayan adım bir öncekinin yılını taşır
    let son = n;
    const yillar = adimlar.map((a) => (a.dataset.yil ? (son = +a.dataset.yil) : son));
    const kur = (y: number) => {
      yilEl.textContent = yilYaz(y);
      notEl.textContent = y === n ? 'ayetin indiği yıllar' : y < n ? 'ayetten önce' : `ayetten ${y - n} yıl sonra`;
      h.style.setProperty('--p', String(Math.min(1, Math.max(0, (y - n) / (k - n || 1)))));
    };
    kur(n);
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const i = adimlar.indexOf(e.target as HTMLElement);
      adimlar.forEach((a, j) => a.classList.toggle('aktif', j === i));
      kur(yillar[i]);
    }), { rootMargin: '-50% 0px -50% 0px' });
    adimlar.forEach((a) => io.observe(a));
  });
</script>

<style>
  .hikaye { --p: 0; position: relative; }
  .sahne { position: sticky; top: 64px; height: calc(100svh - 64px); pointer-events: none; z-index: 1; overflow: hidden; }
  .fon { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; padding: 0 16px; text-align: center; font-size: clamp(4rem, 14vw, 11rem); line-height: 1.3; color: var(--murekkep); opacity: 0.045; }

  /* Yıl paneli: rum.html'deki HUD ile aynı ölçüler; geniş kartlarla aynı eksen */
  .hud {
    position: relative; width: min(760px, 100% - 24px); margin: 12px auto 0; display: grid; grid-template-columns: auto 1fr; gap: 6px 28px; align-items: center;
    padding: 14px 18px; background: color-mix(in srgb, var(--yuzey) 96%, transparent); border-radius: var(--radius); box-shadow: var(--golge);
  }
  .hud-yil { margin: 0; display: flex; flex-direction: column; font: 700 2.75rem/1 var(--font-baslik); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; min-width: 4ch; }
  .hud-yil small { font: 500 0.75rem/1.3 var(--font-arayuz); letter-spacing: 0; color: var(--soluk); margin-top: 8px; white-space: nowrap; }
  .ray { position: relative; height: 4px; border-radius: 2px; background: var(--yuzey-2); margin: 10px 6px 0; }
  .dolu { position: absolute; inset: 0; border-radius: 2px; background: var(--vurgu); transform-origin: left; transform: scaleX(var(--p)); transition: transform 600ms var(--ease-hareket); }
  .isaret-kap { position: absolute; inset: 0; transform: translateX(calc(var(--p) * 100%)); transition: transform 600ms var(--ease-hareket); }
  .isaret { position: absolute; left: -7px; top: -5px; width: 14px; height: 14px; border-radius: 50%; background: var(--yuzey); box-shadow: 0 0 0 3px var(--vurgu); }
  .uclar { display: flex; justify-content: space-between; gap: 8px; margin-top: 12px; font: 500 0.75rem var(--font-arayuz); color: var(--soluk); }

  .adimlar { position: relative; z-index: 2; margin-top: calc(64px - 100svh); }
  .adimlar > :global(.adim:first-child) { padding-top: 30svh; }
  .adimlar > :global(.adim:last-child) { padding-bottom: 30svh; }

  @media (max-width: 899px) {
    .hud { gap: 4px 14px; padding: 10px 12px; }
    .hud-yil { font-size: 1.75rem; }
    .hud-yil small { font-size: 0.6875rem; margin-top: 6px; }
    .uclar { font-size: 0.6875rem; margin-top: 8px; }
  }
</style>
