---
// Sayfanın son sözü: düşündüren tek soru.
import Yildiz from './Yildiz.astro';
---
<section class="meydan belir">
  <span class="ikon"><Yildiz boyut={36} /></span>
  <p><slot /></p>
</section>

<style>
  .meydan { margin: var(--s8) 0 var(--s6); padding: var(--s7) 0; text-align: center; border-block: 1px solid var(--cizgi-renk); }
  .ikon { color: var(--vurgu); display: inline-block; margin-bottom: var(--s4); }
  p { font-family: var(--font-baslik); font-size: clamp(1.6rem, 3.8vw, 2.5rem); line-height: 1.3; max-width: 28ch; margin: 0 auto; }
</style>
