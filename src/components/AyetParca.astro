---
// Akış içinde ayetin yalnız mucize olan kısmı: kısa Arapça parça + meal parçası; mucizeye işaret eden ifade sarı fosforlu.
import Yildiz from './Yildiz.astro';
interface Props { sure: number; ayet: number; sureAdi: string; ar: string; meal: string; vurgu: string; mutercim?: string }
const { sure, ayet, sureAdi, ar, meal, vurgu, mutercim = 'Diyanet İşleri Başkanlığı' } = Astro.props;
const [once, sonra] = meal.includes(vurgu) ? meal.split(vurgu) : [meal, ''];
const pad = (n: number) => String(n).padStart(3, '0');
const ses = `https://everyayah.com/data/Alafasy_128kbps/${pad(sure)}${pad(ayet)}.mp3`;
---
<figure class="ayet-parca">
  <p class="ar arapca" lang="ar">{ar}</p>
  <blockquote class="meal">«{once}{meal.includes(vurgu) && <mark>{vurgu}</mark>}{sonra}»</blockquote>
  <figcaption class="arayuz">
    <Yildiz boyut={14} /> {sureAdi} {sure}:{ayet} · Meal: {mutercim}
    <button type="button" class="dinle" data-ses={ses} aria-label="Ayeti dinle">▶ Dinle</button>
  </figcaption>
</figure>

<script>
  let calan: HTMLAudioElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('.ayet-parca .dinle').forEach((b) =>
    b.addEventListener('click', () => {
      if (calan && !calan.paused) { calan.pause(); if (calan.src === b.dataset.ses) return; }
      calan = new Audio(b.dataset.ses); calan.play();
    }),
  );
</script>

<style>
  .ayet-parca { margin: var(--s6) 0; padding: var(--s4) 0 var(--s4) var(--s4); border-left: 3px solid var(--vurgu); }
  .ar { font-size: clamp(1.8rem, 4vw, 2.4rem); line-height: 1.9; margin: 0 0 var(--s2); text-align: right; }
  .meal { margin: 0 0 var(--s3); font-family: var(--font-baslik); font-size: clamp(1.3rem, 2.8vw, 1.7rem); line-height: 1.5; }
  mark { background: linear-gradient(transparent 50%, var(--fosfor) 50%); color: inherit; padding: 0 2px; }
  figcaption { display: flex; align-items: center; gap: var(--s2); flex-wrap: wrap; font-size: var(--fs-xs); color: var(--soluk); }
  figcaption :global(svg) { color: var(--vurgu); }
  .dinle { font: inherit; margin-left: auto; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--cizgi-renk); background: var(--yuzey); color: var(--murekkep); cursor: pointer; }
  .dinle:hover { border-color: var(--vurgu); color: var(--vurgu); }
</style>
