---
// Rahim bilgisi: rahim iç zarının aylık döngüsü. Kaydırıcı (ve hareket serbestse kendiliğinden akış) zarı
// kalınlaştırır, döker, yeniden kurar. Etiketler yalnız metindeki kelimeler: tağîdu (azalır), tezdâdu (artar).
// Şema temsilîdir: gün sayısı, ölçü yok.
const bez = Array.from({ length: 14 }, (_, i) => 30 + i * 40);
---
<section class="rd" aria-label="Rahim iç zarının aylık döngüsü">
  <div class="rd-sahne">
    <svg viewBox="0 0 600 260" role="img" aria-label="Şema: rahim duvarı ve üstündeki iç zar. Zar ay boyunca kalınlaşır, sonra dökülür ve yeniden kurulur." >
      <rect x="0" y="200" width="600" height="60" class="kas" />
      <text x="16" y="240" class="etk">rahim duvarı</text>
      <path class="zar" d="M0 200 L600 200 L600 190 L0 190 Z" />
      <g class="bezler">
        {bez.map((x) => <path class="bez" data-x={x} d={`M${x} 200 L${x} 190`} />)}
      </g>
      <g class="dokuntu" aria-hidden="true">
        {bez.map((x, i) => <circle class="dk" data-i={i} cx={x + 14} cy="150" r="3" />)}
      </g>
      <text x="584" y="30" text-anchor="end" class="kelime" data-k="azal">tağîdu · azalır</text>
      <text x="584" y="30" text-anchor="end" class="kelime" data-k="art">tezdâdu · artar</text>
    </svg>
  </div>
  <div class="rd-kontrol arayuz">
    <button type="button" class="oynat" aria-pressed="false">▶ Akıt</button>
    <label>
      <span class="gorunmez">Döngüde ilerle</span>
      <input type="range" min="0" max="1000" value="620" />
    </label>
  </div>
  <ol class="rd-evre arayuz" aria-live="polite">
    <li data-e="0">dökülür</li>
    <li data-e="1">yeniden kurulur</li>
    <li data-e="2">kalınlaşır</li>
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.rd').forEach((sec) => {
    const zar = sec.querySelector<SVGPathElement>('.zar')!;
    const bezler = [...sec.querySelectorAll<SVGPathElement>('.bez')];
    const dk = [...sec.querySelectorAll<SVGCircleElement>('.dk')];
    const kelime = [...sec.querySelectorAll<SVGTextElement>('.kelime')];
    const evre = [...sec.querySelectorAll<HTMLLIElement>('.rd-evre li')];
    const range = sec.querySelector<HTMLInputElement>('input')!;
    const btn = sec.querySelector<HTMLButtonElement>('.oynat')!;
    const rm = matchMedia('(prefers-reduced-motion: reduce)');
    const W = 600, ZEMIN = 200;
    const ease = (x: number) => x * x * (3 - 2 * x);

    // Döngü 0→1: 0-0.18 dökülme (kalın→ince), 0.18-1 yeniden kurulma ve kalınlaşma.
    const kalinlik = (p: number) => (p < 0.18 ? 1 - ease(p / 0.18) * 0.9 : 0.1 + ease((p - 0.18) / 0.82) * 0.9);

    function ciz(p: number) {
      const k = kalinlik(p);
      const h = 14 + k * 130;
      const pts: string[] = [];
      for (let x = 0; x <= W; x += 20) {
        const dalga = Math.sin(x / 37 + p * 6) * 4 * k + Math.sin(x / 13) * 2 * k;
        const yirtik = p < 0.18 ? Math.abs(Math.sin(x / 23 + 1.3)) * 18 * (1 - k) : 0;
        pts.push(`${x} ${ZEMIN - h - dalga + yirtik}`);
      }
      zar.setAttribute('d', `M0 ${ZEMIN} L${pts.join(' L')} L${W} ${ZEMIN} Z`);
      bezler.forEach((b, i) => {
        const x = +b.dataset.x!;
        const t = ZEMIN - h * 0.85;
        const kivrim = k > 0.6 ? (k - 0.6) * 22 : 0; // kalınlaştıkça bezler kıvrılır
        b.setAttribute('d', `M${x} ${ZEMIN} C ${x + kivrim} ${ZEMIN - h * 0.3}, ${x - kivrim} ${ZEMIN - h * 0.6}, ${x + (i % 2 ? 3 : -3)} ${t}`);
      });
      const dokul = p < 0.18 ? p / 0.18 : 0;
      dk.forEach((c, i) => {
        c.setAttribute('cy', String(ZEMIN - 40 - dokul * 30 - (i % 3) * 8));
        c.style.opacity = p < 0.18 ? String(Math.sin(dokul * Math.PI)) : '0';
      });
      const azal = p < 0.18;
      kelime[0].style.opacity = azal ? '1' : '0';
      kelime[1].style.opacity = azal ? '0' : '1';
      const e = p < 0.18 ? 0 : p < 0.45 ? 1 : 2;
      evre.forEach((li, i) => li.classList.toggle('aktif', i === e));
    }

    let oynuyor = false, son = 0;
    function adim(t: number) {
      if (!oynuyor) return;
      const dt = son ? t - son : 0; son = t;
      range.value = String((+range.value + dt * 0.12) % 1000);
      ciz(+range.value / 1000);
      requestAnimationFrame(adim);
    }
    function ayarla(acik: boolean) {
      oynuyor = acik; son = 0;
      btn.setAttribute('aria-pressed', String(acik));
      btn.textContent = acik ? '❚❚ Durdur' : '▶ Akıt';
      if (acik) requestAnimationFrame(adim);
    }
    btn.addEventListener('click', () => ayarla(!oynuyor));
    range.addEventListener('input', () => { ayarla(false); ciz(+range.value / 1000); });
    ciz(+range.value / 1000);

    // Hareket serbestse görünür olunca kendiliğinden akar.
    if (!rm.matches) {
      new IntersectionObserver(([g]) => ayarla(g.isIntersecting), { threshold: 0.5 }).observe(sec);
    }
  });
</script>

<style>
  .rd { margin: var(--s6) 0; padding: var(--s4); border-radius: var(--radius); background: var(--yuzey); border: 1px solid var(--cizgi-renk); }
  .rd-sahne svg { display: block; width: 100%; height: auto; }
  .kas { fill: color-mix(in srgb, var(--konu-insan) 30%, var(--yuzey-2)); }
  .zar { fill: color-mix(in srgb, var(--konu-insan) 55%, var(--yuzey)); }
  .bez { fill: none; stroke: var(--yuzey); stroke-width: 3; stroke-linecap: round; opacity: 0.8; }
  .dk { fill: var(--konu-insan); }
  .etk { font: 500 13px var(--font-arayuz); fill: var(--murekkep); opacity: 0.7; }
  .kelime { font: 600 17px var(--font-arayuz); fill: var(--murekkep); transition: opacity var(--t-bilesen); }
  .rd-kontrol { display: flex; gap: var(--s3); align-items: center; margin-top: var(--s3); }
  .rd-kontrol label { flex: 1; display: flex; }
  .rd-kontrol input { width: 100%; accent-color: var(--vurgu); }
  .oynat { font: inherit; font-size: var(--fs-xs); padding: 6px 14px; border-radius: 999px; border: 1px solid var(--cizgi-renk); background: var(--zemin); color: var(--murekkep); cursor: pointer; white-space: nowrap; }
  .oynat:hover { border-color: var(--vurgu); color: var(--vurgu); }
  .gorunmez { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .rd-evre { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s2); margin: var(--s3) 0 0; padding: 0; font-size: var(--fs-xs); text-align: center; }
  .rd-evre li { padding: 6px; border-radius: 999px; color: var(--soluk); border: 1px solid transparent; transition: all var(--t-bilesen); }
  .rd-evre li.aktif { color: var(--vurgu); border-color: var(--vurgu); background: var(--vurgu-zemin); }
</style>
